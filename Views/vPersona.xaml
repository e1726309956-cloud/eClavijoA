<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="eClavijoA.Views.vPersona"
             Title="vPersona">
    <VerticalStackLayout
        Padding="20"
        Spacing="10">
        <Label 
            Text="SEMANA 5: BASE DE DATOS LOCALES"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        
        <Entry
            x:Name="txtNombre"
            Placeholder="Ingresa el Nombre"/>

        <Entry
    x:Name="txtIdEliminar"
    Placeholder="Ingrese el ID a eliminar"
    Keyboard="Numeric"/>

        <Grid Padding="5" RowSpacing="5" ColumnSpacing="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button
                x:Name="btnAgregar"
                Text="Agregar"
                Grid.Row="0"
                Grid.Column="0"
                Clicked="btnAgregar_Clicked"/>
            <Label x:Name="lblStatusMensaje"
                TextColor="Red"
                Text=""
                Grid.Row="1"
                Grid.Column="0"/>
            <Button
                x:Name="btnMostrar"
                Text="Mostrar Personas"
                Grid.Row="2"
                Grid.Column="0"
                Clicked="btnMostrar_Clicked"/>
            <Button
    x:Name="btnEliminar"
    Text="Eliminar Persona"
    Clicked="btnEliminar_Clicked"
                                Grid.Row="3"
                Grid.Column="0"/>
            
            
            <CollectionView x:Name="listaPersonas"
                            Grid.Row="4"
                            Grid.Column="0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Text="{Binding Id}"
                                     Grid.Row="0"
                                     Grid.Column="0"/>
                            <Label Text="{Binding Name}"
                                     Grid.Row="0"
                                     Grid.Column="1"/>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            

        </Grid>






    </VerticalStackLayout>
</ContentPage>